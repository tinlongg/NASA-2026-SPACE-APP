# One place for local secrets. Copy to `.env` in the repo root (it is git-ignored) and fill in the values.
# `npm start` in web/ and the voice script read this file; web/.env, if present, overrides it.
# Hosted sites use the hosting provider's secrets instead; never commit real values.

# MUSE (Meta) for journal reflections, Camera Coach and photo descriptions
META_API_KEY=
META_MODEL=muse-spark-1.3

# ElevenLabs: voice clips (backend/scripts/generate_voice.py) and alert phone calls
ELEVENLABS_API_KEY=
ELEVENLABS_ALERT_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=

# Web Push: run `node web/scripts/generate-vapid.mjs` to create the key pair
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional: mission admin account (JSON with id, username, salt, hash)
# MISSION_ADMIN_ACCOUNT=
