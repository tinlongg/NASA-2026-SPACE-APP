# Copy to .env and export, or set these in your shell. Never commit a real key.

# Optional. Without a key the service runs in extractive mode (quotes retrieved passages, no LLM).
ANTHROPIC_API_KEY=

# Optional overrides
MUSE_LLM_MODEL=claude-opus-5-5
MUSE_LLM_ENABLED=1
MUSE_SOURCES_DIR=sources
MUSE_MIN_SCORE=1.0
MUSE_TOP_K=4
